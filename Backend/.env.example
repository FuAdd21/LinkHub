# ==============================================================================
# LinkHub — Backend Environment Configuration Example
# Copy this file to .env and adjust values for your local or production environment.
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development
PORT=3002

# Database Connection (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=linkhub
DB_CONNECTION_LIMIT=10

# Authentication & Security
# WARNING: Generate a secure random string for production (e.g. openssl rand -base64 32)
JWT_SECRET=super_secret_linkhub_development_key_change_in_prod
JWT_EXPIRES_IN=7d

# Analytics IP Anonymization Salt (Required in production)
IP_SALT=linkhub_dev_ip_salt_not_for_production

# Frontend Application URL (for CORS and reset email links)
FRONTEND_URL=http://localhost:5173

# Uploads Configuration
MAX_UPLOAD_SIZE=5242880

# Link Limits
MAX_LINKS_PER_USER=50

# External Social Media APIs (Optional)
YOUTUBE_API_KEY=
TELEGRAM_BOT_TOKEN=

# SMTP Email Settings (Optional, falls back to dev logging if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=LinkHub <noreply@linkhub.com>
